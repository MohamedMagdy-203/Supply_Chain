FROM python:3.12-slim

WORKDIR /app

# Install system dependencies (build-essential, etc. if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt httpx2

# Copy necessary project directories
COPY src/ /app/src/
COPY app/ /app/app/
COPY predictions/ /app/predictions/
COPY data/processed/weekly.parquet /app/data/processed/weekly.parquet
COPY data/processed/inventory.parquet /app/data/processed/inventory.parquet
COPY reports/model_metrics.csv /app/reports/model_metrics.csv

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PREDICTIONS_DIR=/app/predictions
ENV WEEKLY_PATH=/app/data/processed/weekly.parquet
ENV INVENTORY_PATH=/app/data/processed/inventory.parquet
ENV METRICS_PATH=/app/reports/model_metrics.csv
ENV DEFAULT_MODEL=lgbm

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
